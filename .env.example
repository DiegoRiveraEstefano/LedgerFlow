# ==============================================================================
# LedgerFlow - Environment Configuration Example
# ==============================================================================

# Database (PostgreSQL)
POSTGRES_USER=ledgerflow
POSTGRES_PASSWORD=ledgerflow_secret
POSTGRES_DB=ledgerflow_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ledgerflow:ledgerflow_secret@localhost:5432/ledgerflow_db?schema=public

# Cache & Message Broker (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=ledgerflow_redis

# NestJS API Server
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

# Security & Authentication (JWT)
JWT_SECRET=ledgerflow_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Frontend (Vite)
VITE_API_URL=http://localhost:4000/api/v1
